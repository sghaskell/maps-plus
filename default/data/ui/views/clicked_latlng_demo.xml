  </row>
  <row>
    <panel depends="$clickedLatLng$">
      <title>Clicked Coordinates</title>
      <table>
        <search>
          <query>| makeresults
| eval lat="$clickedLat$", lng="$clickedLng$", coordinates="$clickedLatLng$"
| table lat, lng, coordinates</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
    <panel depends="$clickedLatLng$">
      <title>Nearest Markers (within 500km)</title>
      <table>
        <search>
          <query>| makeresults count=15
| streamstats count as _serial
| eval _serial=_serial-1
| eval lat=mvindex(split("47.6,34.05,41.8,29.7,33.4,39.9,25.7,44.9,36.1,45.5,32.7,39.7,35.2,30.3,42.3", ","), _serial)
| eval lng=mvindex(split("-122.3,-118.2,-87.6,-95.3,-112.0,-75.1,-80.4,-93.2,-115.1,-122.6,-117.1,-104.9,-80.8,-97.7,-71.0", ","), _serial)
| eval title=mvindex(split("Seattle,Los Angeles,Chicago,Houston,Phoenix,Philadelphia,Miami,Minneapolis,Las Vegas,Portland,San Diego,Denver,Charlotte,Austin,Boston", ","), _serial)
| eval clicked_lat=$clickedLat$, clicked_lng=$clickedLng$
| eval dlat=(lat-clicked_lat)*pi()/180, dlng=(lng-clicked_lng)*pi()/180
| eval a=pow(sin(dlat/2),2)+cos(clicked_lat*pi()/180)*cos(lat*pi()/180)*pow(sin(dlng/2),2)
| eval distance_km=round(6371*2*asin(sqrt(a)),1)
| where distance_km &lt; 500
| sort distance_km
| table title, lat, lng, distance_km
| rename title as "Location", lat as "Latitude", lng as "Longitude", distance_km as "Distance (km)"</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
    <panel depends="$clickedLatLng$">
      <title>Open in Maps</title>
      <table>
        <search>
          <query>| makeresults
| eval label="Open $clickedLatLng$ in Google Maps"
| table label</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="drilldown">row</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <link target="_blank">https://www.google.com/maps?q=$clickedLat$,$clickedLng$</link>
        </drilldown>
      </table>
    </panel>
  </row>
</form>