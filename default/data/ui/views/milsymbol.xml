<form version="1.1">
  <label>Milsymbol</label>
  <fieldset submitButton="false">
    <input type="text" token="latitude" searchWhenChanged="true">
      <label>latitude</label>
      <prefix>latitude="</prefix>
      <initialValue>51.205808</initialValue>
      <suffix>"</suffix>
    </input>
    <input type="text" token="longitude" searchWhenChanged="true">
      <label>longitude</label>
      <prefix>longitude="</prefix>
      <initialValue>-2.168427</initialValue>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msSidc" searchWhenChanged="true">
      <label>msSidc</label>
      <prefix>msSidc="</prefix>
      <initialValue>sfgpewrh--mt</initialValue>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msDirection" searchWhenChanged="true">
      <label>msDirection</label>
      <default>(750 * 360) / 6400</default>
      <prefix>msDirection=</prefix>
    </input>
    <input type="text" token="msQuantity" searchWhenChanged="true">
      <label>msQuantity</label>
      <default>100</default>
      <prefix>msQuantity="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msStaffComments" searchWhenChanged="true">
      <label>msStaffComments</label>
      <default>for reinforcements</default>
      <prefix>msStaffComments="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msAdditionalInformation" searchWhenChanged="true">
      <label>msAdditionalInformation</label>
      <default>added support for JJ</default>
      <prefix>msAdditionalInformation="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msType" searchWhenChanged="true">
      <label>msType</label>
      <default>machine gun</default>
      <prefix>msType="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msDtg" searchWhenChanged="true">
      <label>msDtg</label>
      <default>30140000ZSEP97</default>
      <prefix>msDtg="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msLocation" searchWhenChanged="true">
      <label>msLocation</label>
      <default>0900000.0E570306.0N</default>
      <prefix>msLocation="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="text" token="msSize" searchWhenChanged="true">
      <label>msSize</label>
      <default>35</default>
      <prefix>msSize="</prefix>
      <suffix>"</suffix>
    </input>
    <input type="dropdown" token="msColorMode" searchWhenChanged="true">
      <label>msColorMode</label>
      <choice value="Light">Light</choice>
      <choice value="Medium">Medium</choice>
      <choice value="Dark">Dark</choice>
      <default>Light</default>
      <prefix>msColorMode="</prefix>
      <suffix>"</suffix>
      <initialValue>Light</initialValue>
    </input>
    <input type="dropdown" token="frame" searchWhenChanged="true">
      <label>Frame</label>
      <choice value="true">True</choice>
      <choice value="false">False</choice>
      <default>True</default>
      <prefix>msFrame="</prefix>
      <suffix>"</suffix>
      <initialValue>true</initialValue>
    </input>
  </fieldset>
  <row>
    <panel>
      <html>
      <p>
        See the <a href="https://github.com/spatialillusions/milsymbol" target="new">milsymbol documentation</a> and <a href="https://github.com/spatialillusions/milsymbol/tree/master/docs" target="new">available parameters</a> for detailed usage. Milsymbol supports NATO or US standards (MIL-STD-2525C, MIL-STD-2525D, STANAG APP-6 B, STANAG APP-6 D). 
      </p>
      <p>
        Milsymbol parameters are accessible as camel cased fields in SPL, prefixed by <b>
            <i>ms</i>
          </b>, with the following letter uppercased. For example, the <b>
            <i>additionalInformation</i>
          </b> modifier is set using the field <b>
            <i>msAdditionalInformation</i>
          </b> in SPL.
      </p>
      <p>
        Use the <a href="https://github.com/sghaskell/maps-plus/#renderer" target="new">canvas renderer</a> if you plan to plot thousands of icons as it will scale in the browser better.
      </p>
      <p>
        <a href="https://spatialillusions.com" target="new">Spatial Illusions</a> has a handy <a href="https://spatialillusions.com/unitgenerator" target="new">unit generator tool</a> to generate an SIDC (Symbol Identification Code).
      </p>
    </html>
    </panel>
  </row>
  <row>
    <panel>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults 
| eval $latitude$, $longitude$, markerType="milsymbol", $msSidc$, $msDirection$, $msSize$, $msQuantity$, $msStaffComments$,$msAdditionalInformation$,$msDirection$,$msType$,$msDtg$,$msLocation$,$msColorMode$,$frame$
| table latitude, longitude, markerType, msSidc, msDirection,msSize,msQuantity,msStaffComments,msAdditionalInformation,msDirection,msType,msDtg,msLocation,msColorMode,msFrame</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <sampleRatio>1</sampleRatio>
        </search>
