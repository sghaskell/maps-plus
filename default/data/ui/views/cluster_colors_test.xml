<dashboard version="1.1">
  <label>Cluster Colors — Feature Test</label>
  <description>Validation dashboard for clusterGroup color feature (issue #39). Each panel tests one scenario. All use makeresults — no external data needed.</description>

  <!-- ============================================================
       SCENARIO 1: Formatter-driven colors
       Expected: servers = red (#E74C3C), routers = blue (#3498DB),
                 switches = green (#2ECC71)
       ============================================================ -->
  <row>
    <panel>
      <html><h3>Scenario 1 — Formatter colors</h3>
        <p>Three clusterGroups colored via <code>clusterGroupColors</code> formatter option.
        <br/><b>Expect:</b> servers = red, routers = blue, switches = green. All flat (same shade at all sizes).</p>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=90
| streamstats count as i
| eval latitude=case(i&lt;=30, 41.8 + (i%6-3)*0.4, i&lt;=60, 34.0 + (i%6-3)*0.4, 1=1, 29.8 + (i%6-3)*0.4)
| eval longitude=case(i&lt;=30, -87.6 + (i%5-2)*0.4, i&lt;=60, -118.2 + (i%5-2)*0.4, 1=1, -95.4 + (i%5-2)*0.4)
| eval clusterGroup=case(i&lt;=30,"servers",i&lt;=60,"routers",1=1,"switches")
| table latitude, longitude, clusterGroup</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="leaflet_maps_app.maps-plus.cluster">1</option>
        <option name="leaflet_maps_app.maps-plus.clusterGroupColors">servers:#E74C3C, routers:#3498DB, switches:#2ECC71</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoom">1</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoomDelay">500</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">39.50</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-98.35</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">4</option>
        <option name="leaflet_maps_app.maps-plus.maxClusterRadius">80</option>
        <option name="leaflet_maps_app.maps-plus.animate">1</option>
        <option name="leaflet_maps_app.maps-plus.showProgress">1</option>
        <option name="leaflet_maps_app.maps-plus.rangeOneBgColor">#B5E28C</option>
        <option name="leaflet_maps_app.maps-plus.rangeOneFgColor">#6ECC39</option>
        <option name="leaflet_maps_app.maps-plus.rangeTwoBgColor">#F1D357</option>
        <option name="leaflet_maps_app.maps-plus.rangeTwoFgColor">#F0C20C</option>
        <option name="leaflet_maps_app.maps-plus.rangeThreeBgColor">#FD9C73</option>
        <option name="leaflet_maps_app.maps-plus.rangeThreeFgColor">#F18017</option>
        <option name="leaflet_maps_app.maps-plus.warningThreshold">55</option>
        <option name="leaflet_maps_app.maps-plus.criticalThreshold">80</option>
      </viz>
    </panel>
  </row>

  <!-- ============================================================
       SCENARIO 2: SPL field overrides formatter
       Formatter sets servers=red, but SPL clusterBgColor/FgColor=purple
       Expected: all clusters render purple regardless of formatter
       ============================================================ -->
  <row>
    <panel>
      <html><h3>Scenario 2 — SPL field overrides formatter</h3>
        <p>Formatter sets <code>servers_spl:#E74C3C</code> (red), but SPL fields <code>clusterBgColor</code> and <code>clusterFgColor</code> override to purple.
        <br/><b>Expect:</b> clusters render purple (#9B59B6), not red.</p>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=40
| streamstats count as i
| eval latitude=41.8 + (i%6-3)*0.4
| eval longitude=-87.6 + (i%5-2)*0.4
| eval clusterGroup="servers_spl"
| eval clusterBgColor="#9B59B6"
| eval clusterFgColor="#8E44AD"
| table latitude, longitude, clusterGroup, clusterBgColor, clusterFgColor</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="leaflet_maps_app.maps-plus.cluster">1</option>
        <option name="leaflet_maps_app.maps-plus.clusterGroupColors">servers_spl:#E74C3C</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoom">1</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoomDelay">500</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">41.8</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-87.6</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">10</option>
        <option name="leaflet_maps_app.maps-plus.maxClusterRadius">80</option>
        <option name="leaflet_maps_app.maps-plus.animate">1</option>
        <option name="leaflet_maps_app.maps-plus.showProgress">1</option>
        <option name="leaflet_maps_app.maps-plus.warningThreshold">55</option>
        <option name="leaflet_maps_app.maps-plus.criticalThreshold">80</option>
      </viz>
    </panel>
  </row>

