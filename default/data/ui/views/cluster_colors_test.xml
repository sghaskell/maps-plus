          <query>| makeresults count=90
| streamstats count as i
| eval latitude=39.5 + (i%10-5)*1.2
| eval longitude=-98.35 + (i%9-4)*1.5
| eval clusterGroup="default"
| table latitude, longitude, clusterGroup</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="leaflet_maps_app.maps-plus.cluster">1</option>
        <option name="leaflet_maps_app.maps-plus.clusterGroupColors"></option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoom">1</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoomDelay">500</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">39.50</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-98.35</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">5</option>
        <option name="leaflet_maps_app.maps-plus.maxClusterRadius">80</option>
        <option name="leaflet_maps_app.maps-plus.animate">1</option>
        <option name="leaflet_maps_app.maps-plus.showProgress">1</option>
        <option name="leaflet_maps_app.maps-plus.rangeOneBgColor">#B5E28C</option>
        <option name="leaflet_maps_app.maps-plus.rangeOneFgColor">#6ECC39</option>
        <option name="leaflet_maps_app.maps-plus.rangeTwoBgColor">#F1D357</option>
        <option name="leaflet_maps_app.maps-plus.rangeTwoFgColor">#F0C20C</option>
        <option name="leaflet_maps_app.maps-plus.rangeThreeBgColor">#FD9C73</option>
        <option name="leaflet_maps_app.maps-plus.rangeThreeFgColor">#F18017</option>
        <option name="leaflet_maps_app.maps-plus.warningThreshold">55</option>
        <option name="leaflet_maps_app.maps-plus.criticalThreshold">80</option>
      </viz>
    </panel>
  </row>

  <!-- ============================================================
       SCENARIO 4: `default` reserved key fallback
       Formatter: only `default:#2ECC71` (green). clusterGroup="unknown_group"
       Expected: unmatched group falls back to green
       ============================================================ -->
  <row>
    <panel>
      <html><h3>Scenario 4 — <code>default</code> key fallback</h3>
        <p>Formatter has only <code>default:#2ECC71</code>. clusterGroup value is <code>unknown_group</code> (not in the mapping).
        <br/><b>Expect:</b> clusters render green via the <code>default</code> fallback.</p>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=40
| streamstats count as i
| eval latitude=34.0 + (i%6-3)*0.4
| eval longitude=-118.2 + (i%5-2)*0.4
| eval clusterGroup="unknown_group"
| table latitude, longitude, clusterGroup</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="leaflet_maps_app.maps-plus.cluster">1</option>
        <option name="leaflet_maps_app.maps-plus.clusterGroupColors">default:#2ECC71</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoom">1</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoomDelay">500</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">34.0</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-118.2</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">10</option>
        <option name="leaflet_maps_app.maps-plus.maxClusterRadius">80</option>
        <option name="leaflet_maps_app.maps-plus.animate">1</option>
        <option name="leaflet_maps_app.maps-plus.showProgress">1</option>
        <option name="leaflet_maps_app.maps-plus.warningThreshold">55</option>
        <option name="leaflet_maps_app.maps-plus.criticalThreshold">80</option>
      </viz>
    </panel>
  </row>

  <!-- ============================================================
       SCENARIO 5: rgba and named colors
       servers=rgba(231,76,60,0.4) — semi-transparent red
       routers=steelblue — CSS named color
       Expected: servers visibly more transparent than routers
       ============================================================ -->
  <row>
    <panel>
      <html><h3>Scenario 5 — rgba and named CSS colors</h3>
        <p>Formatter: <code>servers:rgba(231,76,60,0.4)</code> (semi-transparent red), <code>routers:steelblue</code> (named color).
        <br/><b>Expect:</b> server clusters render at 40% opacity red, router clusters render steelblue at full opacity.</p>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=60
| streamstats count as i
| eval latitude=case(i&lt;=30, 41.8 + (i%6-3)*0.4, 1=1, 34.0 + (i%6-3)*0.4)
| eval longitude=case(i&lt;=30, -87.6 + (i%5-2)*0.4, 1=1, -118.2 + (i%5-2)*0.4)
| eval clusterGroup=if(i&lt;=30,"servers","routers")
| table latitude, longitude, clusterGroup</query>
          <earliest>-1m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="leaflet_maps_app.maps-plus.cluster">1</option>
        <option name="leaflet_maps_app.maps-plus.clusterGroupColors">servers:rgba(231,76,60,0.4), routers:steelblue</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoom">1</option>
        <option name="leaflet_maps_app.maps-plus.autoFitAndZoomDelay">500</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">39.50</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-98.35</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">4</option>
        <option name="leaflet_maps_app.maps-plus.maxClusterRadius">80</option>
        <option name="leaflet_maps_app.maps-plus.animate">1</option>
        <option name="leaflet_maps_app.maps-plus.showProgress">1</option>
        <option name="leaflet_maps_app.maps-plus.warningThreshold">55</option>
        <option name="leaflet_maps_app.maps-plus.criticalThreshold">80</option>
      </viz>
    </panel>
  </row>

</dashboard>
