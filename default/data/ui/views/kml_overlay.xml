<dashboard version="1.1">
  <label>KML Overlay</label>
  <description>Demonstrates KML and KMZ overlay support with toggleable layer control entries.</description>

  <row>
    <panel>
      <html>
        <h2>KML / KMZ Overlay</h2>
        <p>Maps+ can load KML and KMZ files as overlay layers on top of your map. Each file is registered as a named, toggleable entry in the layer control widget.</p>
        <p><b>Local files</b> are served from <code>appserver/static/visualizations/maps-plus/contrib/kml/</code> inside the app. Specify just the filename (e.g. <code>sample.kml</code>).</p>
        <p><b>Remote files</b> are fetched by URL. Use the full <code>https://</code> address. The Splunk server must be able to reach the URL.</p>
        <p>Multiple files can be loaded at once by separating them with commas in the <b>KML Overlay</b> formatter option. Each file gets its own toggle in the layer control.</p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Local KML — sample.kml</title>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=1 | eval latitude=39.5, longitude=-98.35</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="leaflet_maps_app.maps-plus.mapTile">https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">4</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">39.5</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-98.35</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.layerControl">1</option>
        <option name="leaflet_maps_app.maps-plus.kmlOverlay">sample.kml</option>
      </viz>
    </panel>
    <panel>
      <title>Local KMZ — sample.kmz</title>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=1 | eval latitude=39.5, longitude=-98.35</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="leaflet_maps_app.maps-plus.mapTile">https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">4</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">39.5</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-98.35</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.layerControl">1</option>
        <option name="leaflet_maps_app.maps-plus.kmlOverlay">sample.kmz</option>
      </viz>
    </panel>
  </row>

  <row>
    <panel>
      <title>Remote KML URL — NASA WorldWind Samples</title>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=1 | eval latitude=37.4, longitude=-122.1</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="leaflet_maps_app.maps-plus.mapTile">https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">14</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">37.4</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-122.1</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.layerControl">1</option>
        <option name="leaflet_maps_app.maps-plus.kmlOverlay">https://files.worldwind.arc.nasa.gov/artifactory/web/0.9.0/examples/data/KML_Samples.kml</option>
      </viz>
    </panel>
    <panel>
      <title>Multiple Overlays — local KML + remote KML + local KMZ</title>
      <viz type="leaflet_maps_app.maps-plus">
        <search>
          <query>| makeresults count=1 | eval latitude=39.5, longitude=-98.35</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="leaflet_maps_app.maps-plus.mapTile">https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterZoom">4</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLat">39.5</option>
        <option name="leaflet_maps_app.maps-plus.mapCenterLon">-98.35</option>
        <option name="leaflet_maps_app.maps-plus.defaultHeight">400</option>
        <option name="leaflet_maps_app.maps-plus.layerControl">1</option>
        <option name="leaflet_maps_app.maps-plus.kmlOverlay">sample.kml, https://files.worldwind.arc.nasa.gov/artifactory/web/0.9.0/examples/data/KML_Samples.kml, sample.kmz</option>
      </viz>
    </panel>
  </row>

</dashboard>
